{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-pcm",
  "main": "cloudflare/worker.mjs",
  "account_id": "b6729892824bd2bfe8fff7fc75b7b41d",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/public/*.html", "**/public/*.css", "**/public/*.js"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [{ "name": "PCM_WORKSPACE", "class_name": "PCMWorkspace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PCMWorkspace"] }],
  "vars": {
    "WORKSPACE_ID": "pcm-arthurstudy-v1",
    "ACCESS_TEAM_DOMAIN": "https://wispy-dream-0715.cloudflareaccess.com",
    "ACCESS_AUD": "9f5c005e195a525c0190f51dba3b189bbce07fdf3ec40ea0d5a0797fa35dd30e"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
